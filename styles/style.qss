/* =========================================================
   PySide6 Light Theme (Base)
   Convención:
   - Cards: setObjectName("card")
   - Section title: setObjectName("sectionTitle")
   - Toolbars/headers: setObjectName("header")
   - Variantes por property:
       widget.setProperty("variant", "primary" | "danger" | "ghost")
       widget.setProperty("size", "sm" | "md")
   ========================================================= */

/* -------------------------
   Global
------------------------- */
QWidget {
  background: #F6F7F9;
  color: #111827;
  font-family: "Segoe UI";
  font-size: 12px;
}

QLabel {
  background: transparent;
  color: #111827;
}

QFrame {
  background: transparent;
}

QToolTip {
  background: #111827;
  color: #FFFFFF;
  border: none;
  padding: 6px 8px;
  border-radius: 6px;
}

/* -------------------------
   Card / Containers
------------------------- */
#card {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
}

#header {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
}

#sectionTitle {
  color: #111827;
  font-weight: 600;
  font-size: 13px;
}

/* -------------------------
   Inputs
------------------------- */
QLineEdit,
QPlainTextEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit {
  background: #FFFFFF;
  border: 1px solid #D1D5DB;
  border-radius: 8px;
  padding: 6px 10px;
  selection-background-color: #2563EB;
  selection-color: #FFFFFF;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QDateTimeEdit:focus {
  border: 1px solid #2563EB;
}

QLineEdit[readonly="true"],
QPlainTextEdit[readonly="true"],
QTextEdit[readonly="true"] {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
  color: #374151;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QDateTimeEdit:disabled {
  background: #F3F4F6;
  color: #9CA3AF;
  border: 1px solid #E5E7EB;
}

/* ComboBox arrow + popup */
QComboBox {
  padding-right: 26px; /* deja espacio para el botón */
}
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 24px;
  border-left: 1px solid #E5E7EB;
  background: transparent;
}
QComboBox::down-arrow {
  width: 10px;
  height: 10px;
}
QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 1px solid #D1D5DB;
  selection-background-color: #E5EDFF;
  selection-color: #111827;
  outline: none;
}

/* -------------------------
   Buttons
------------------------- */
QPushButton {
  background: #FFFFFF;
  border: 1px solid #D1D5DB;
  border-radius: 8px;
  padding: 6px 12px;
}

QPushButton:hover {
  background: #F3F4F6;
}

QPushButton:pressed {
  background: #E5E7EB;
}

QPushButton:disabled {
  background: #F3F4F6;
  color: #9CA3AF;
  border: 1px solid #E5E7EB;
}

/* Variants by property */
QPushButton[variant="primary"] {
  background: #2563EB;
  color: #FFFFFF;
  border: 1px solid #2563EB;
}
QPushButton[variant="primary"]:hover { background: #1D4ED8; }
QPushButton[variant="primary"]:pressed { background: #1E40AF; }

QPushButton[variant="danger"] {
  background: #DC2626;
  color: #FFFFFF;
  border: 1px solid #DC2626;
}
QPushButton[variant="danger"]:hover { background: #B91C1C; }
QPushButton[variant="danger"]:pressed { background: #991B1B; }

QPushButton[variant="ghost"] {
  background: transparent;
  border: 1px solid transparent;
}
QPushButton[variant="ghost"]:hover {
  background: #F3F4F6;
  border: 1px solid #E5E7EB;
}

/* Size */
QPushButton[size="sm"] { padding: 4px 10px; border-radius: 8px; }
QPushButton[size="md"] { padding: 6px 12px; }

/* -------------------------
   Tables
------------------------- */
QTableWidget,
QTableView {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  gridline-color: #E5E7EB;
  selection-background-color: #E5EDFF;
  selection-color: #111827;
  outline: none;
}

QHeaderView::section {
  background: #F3F4F6;
  color: #111827;
  border: none;
  border-bottom: 1px solid #E5E7EB;
  padding: 6px 8px;
  font-weight: 600;
}

QTableCornerButton::section {
  background: #F3F4F6;
  border: none;
  border-bottom: 1px solid #E5E7EB;
}

QTableWidget::item {
  padding: 6px 8px;
}

QTableWidget::item:selected {
  background: #E5EDFF;
  color: #111827;
}

/* Scrollbars (light) */
QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 2px 2px 2px 2px;
}
QScrollBar::handle:vertical {
  background: #D1D5DB;
  min-height: 22px;
  border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: #9CA3AF; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 2px 2px 2px 2px;
}
QScrollBar::handle:horizontal {
  background: #D1D5DB;
  min-width: 22px;
  border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: #9CA3AF; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* -------------------------
   GroupBox / Separators
------------------------- */
QGroupBox {
  border: 1px solid #E5E7EB;
  border-radius: 12px;
  margin-top: 10px;
  padding: 10px;
  background: #FFFFFF;
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 10px;
  padding: 0 6px;
  color: #111827;
  font-weight: 600;
  background: #FFFFFF;
}

QFrame[frameShape="4"], /* HLine */
QFrame[frameShape="5"]  /* VLine */ {
  color: #E5E7EB;
}

/* -------------------------
   Dialogs
------------------------- */
QDialog {
  background: #F6F7F9;
}

/* Toggle buttons (checkable) */
QPushButton:checked {
  background: #E5EDFF;
  border: 1px solid #2563EB;
  color: #111827;
}

/* ClickableLabel como input */
QLabel[role="input"] {
  background: #FFFFFF;
  border: 1px solid #D1D5DB;
  border-radius: 8px;
  padding: 6px 10px;
}
QLabel[role="input"]:hover {
  background: #F9FAFB;
}